{
    "title": "bar for herd",
    "rules": [
        {
            "description": "bar for herd: fn fn -> F19 (pane search)",
            "manipulators": [
                {
                    "type": "basic",
                    "conditions": [
                        {
                            "type": "variable_if",
                            "name": "herd_fn_tapped",
                            "value": 1
                        }
                    ],
                    "from": {
                        "key_code": "fn",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{ "key_code": "fn" }],
                    "to_if_alone": [
                        {
                            "set_variable": {
                                "name": "herd_fn_tapped",
                                "value": 0
                            }
                        },
                        { "key_code": "f19" }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "fn",
                        "modifiers": { "optional": ["any"] }
                    },
                    "to": [{ "key_code": "fn" }],
                    "to_if_alone": [
                        {
                            "set_variable": {
                                "name": "herd_fn_tapped",
                                "value": 1
                            }
                        }
                    ],
                    "to_delayed_action": {
                        "to_if_invoked": [
                            {
                                "set_variable": {
                                    "name": "herd_fn_tapped",
                                    "value": 0
                                }
                            }
                        ],
                        "to_if_canceled": [
                            {
                                "set_variable": {
                                    "name": "herd_fn_tapped",
                                    "value": 0
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
